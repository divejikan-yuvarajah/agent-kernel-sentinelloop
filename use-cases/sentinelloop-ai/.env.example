# Copy this file to the repository-approved local environment file.
# Never commit real API tokens, service-role keys, or signing secrets.

# Required (SentinelLoop / hackathon)
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_BUDGET_CEILING_USD=3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# Optional / integration-dependent
# Agent Kernel Telegram uses AK_ prefix and nested __ (see api-notes.md).
# TELEGRAM_BOT_TOKEN above is the required hackathon name; map it to
# AK_TELEGRAM__BOT_TOKEN at implementation time, or set both.
# Local polling: python -m integrations.telegram_handler
AK_TELEGRAM__AGENT=intake_agent
AK_TELEGRAM__BOT_TOKEN=
AK_TELEGRAM__WEBHOOK_SECRET=
AK_TELEGRAM__API_VERSION=bot

# Public bot username without @ (QR posters / t.me deep links). Not a secret.
TELEGRAM_BOT_USERNAME=

# Optional numeric chat id for outbound demo sends. Telegram bots cannot
# message a user until that user has /start-ed the bot at least once.
TELEGRAM_CHAT_ID=

# Slack: SLACK_BOT_TOKEN is required above. Signing secret is used by slack-bolt.
SLACK_SIGNING_SECRET=
AK_SLACK__AGENT=coordination_agent
AK_SLACK__AGENT_ACKNOWLEDGEMENT=

# Slack destination channel IDs (not secrets). Leave empty in local/dev.
SLACK_CHANNEL_ELECTRICAL_MAINTENANCE=C0BUMHZK7B2
SLACK_CHANNEL_LAB_SAFETY=C0BTM1FNE3D
SLACK_CHANNEL_MECHANICAL_MAINTENANCE=C0BUMHZK7B2
SLACK_CHANNEL_SAFETY_SUPERVISOR=C0BUMHZK7B2
SLACK_CHANNEL_EMERGENCY_RESPONSE=C0BUMJ2UU80
SLACK_CHANNEL_FACILITIES=C0BUMHZK7B2
SLACK_ESCALATION_CHANNEL=C0BUMJ2UU80

# Native model key used by Agent Kernel OpenAI examples (not OpenRouter).
OPENAI_API_KEY=

# OpenRouter is an application-level provider adapter, not an Agent Kernel extra.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-nemo

SUPABASE_ANON_KEY=

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Predictive risk zones. Groups with frequency_score above this become predicted risk zones.
PREDICTION_FREQUENCY_THRESHOLD=0.15

# Vision role. Paid vision uses the same OPENROUTER_BUDGET_CEILING_USD governor.
VISION_MODEL_PREFERENCE=
VISION_MAX_COST=
VISION_TIMEOUT=45
